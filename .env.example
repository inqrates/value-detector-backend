# === SERVER .env.example ===
# Скопируйте в .env и заполните значения

# ── JWT-секрет (ОБЯЗАТЕЛЬНО смените на продакшене!) ──
# Генерируется: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Минуты жизни access-токена (по умолчанию 120 = 2 часа)
JWT_ACCESS_MINUTES=120

# Часы жизни refresh-токена (по умолчанию 12 часов)
JWT_REFRESH_HOURS=12

# ── HTTPS (необязательно, но рекомендуется) ──
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem

# ── CORS (доверенные домены, через запятую) ──
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,https://yourdomain.com

# ── Админка ──
ADMIN_TOKEN=

# ── Логирование ──
LOG_LEVEL=INFO
DEBUG_PARSERS=0

# ── Прокси (если нужен) ──
LEON_PROXY=
